<?xml version="1.0" encoding="utf-8"?>
<!-- Quartz 启动屏（W6.6）：品牌底色 + 居中宝石，避免冷启白闪。
     底色随系统深浅色（values-night/colors.xml）。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/qz_splash_bg" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/launch_gem" />
    </item>
</layer-list>
